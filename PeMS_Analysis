# Helper functions ----

weighted_speed <- function(speed, flow) {
  
  good <- !is.na(speed) & !is.na(flow) & flow > 0
  
  if (!any(good)) {
    return(NA_real_)
  }
  
  weighted.mean(speed[good], w = flow[good])
}


print_table <- function(title, data, n = 50) {
  
  cat("\n", title, "\n", sep = "")
  base::print(as.data.frame(head(data, n)), row.names = FALSE)
}


safe_min <- function(x) {
  if (all(is.na(x))) {
    return(NA_real_)
  }
  min(x, na.rm = TRUE)
}


safe_median <- function(x) {
  if (all(is.na(x))) {
    return(NA_real_)
  }
  median(x, na.rm = TRUE)
}


safe_mean <- function(x) {
  if (all(is.na(x))) {
    return(NA_real_)
  }
  mean(x, na.rm = TRUE)
}


safe_first_character <- function(x) {
  
  x <- x[!is.na(x) & x != ""]
  
  if (length(x) == 0) {
    return(NA_character_)
  }
  
  x[1]
}


