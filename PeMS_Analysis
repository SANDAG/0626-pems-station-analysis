# Section 6 - Variation workbook ----
#
# This workbook is primarily a QA / method-development output.
#
# Individual day columns let us compare the selected weeks.
# Monthly statistics show the distribution of the underlying hourly records.


## Function to build variation sheets ----

build_output_sheet <- function(data, summary_data, selected_day_group) {
  
  day_data <- data %>%
    filter(day_group == selected_day_group) %>%
    mutate(
      analysis_month = factor(analysis_month, levels = month_order),
      weekday = factor(weekday, levels = weekday_order),
      time_period = factor(time_period, levels = time_periods)
    )
  
  ### Individual day averages ----
  
  daily_wide <- day_data %>%
    select(
      fiscal_year, direction_label, el_station, el_id, gp_station, gp_id,
      day_group, time_period, metric, station_id, column_label, output_value
    ) %>%
    pivot_wider(
      names_from = column_label,
      values_from = output_value,
      values_fill = ""
    )
  
  ### Monthly pooled statistics ----
  
  summary_wide <- summary_data %>%
    filter(day_group == selected_day_group) %>%
    mutate(analysis_month = as.character(analysis_month)) %>%
    pivot_longer(
      cols = c(
        monthly_avg,
        monthly_p25,
        monthly_p75,
        monthly_iqr,
        monthly_min,
        monthly_max,
        monthly_count
      ),
      names_to = "statistic",
      values_to = "stat_value"
    ) %>%
    mutate(
      statistic = recode(
        statistic,
        monthly_avg = "Average",
        monthly_p25 = "25th",
        monthly_p75 = "75th",
        monthly_iqr = "IQR",
        monthly_min = "Min",
        monthly_max = "Max",
        monthly_count = "Count"
      ),
      
      summary_column = paste0(analysis_month, " - ", statistic),
      
      summary_value = case_when(
        statistic == "Count" ~ format(round(stat_value, 0), scientific = FALSE, trim = TRUE),
        TRUE ~ as.character(stat_value)
      )
    ) %>%
    select(
      fiscal_year,
      direction_label,
      station_id,
      day_group,
      time_period,
      metric,
      summary_column,
      summary_value
    ) %>%
    pivot_wider(names_from = summary_column, values_from = summary_value)
  
  ### Join daily and monthly values ----
  
  output <- daily_wide %>%
    left_join(
      summary_wide,
      by = c(
        "fiscal_year",
        "direction_label",
        "station_id",
        "day_group",
        "time_period",
        "metric"
      )
    )
  
  ### Desired column order ----
  
  value_columns <- c()
  
  for (this_month in month_order) {
    
    month_daily_columns <- day_data %>%
      filter(as.character(analysis_month) == this_month) %>%
      mutate(week_number = parse_number(week_name)) %>%
      distinct(week_number, weekday, column_label) %>%
      arrange(week_number, weekday) %>%
      pull(column_label) %>%
      unique()
    
    value_columns <- c(
      value_columns,
      month_daily_columns,
      paste0(this_month, " - Average"),
      paste0(this_month, " - 25th"),
      paste0(this_month, " - 75th"),
      paste0(this_month, " - IQR"),
      paste0(this_month, " - Min"),
      paste0(this_month, " - Max"),
      paste0(this_month, " - Count")
    )
  }
  
  value_columns <- value_columns[value_columns %in% names(output)]
  
  ### Final sheet ----
  
  output %>%
    select(
      fiscal_year,
      direction_label,
      el_station,
      el_id,
      gp_station,
      gp_id,
      day_group,
      time_period,
      metric,
      station_id,
      all_of(value_columns)
    ) %>%
    select(-station_id) %>%
    arrange(direction_label, el_station, time_period, metric, fiscal_year) %>%
    rename(direction = direction_label)
}


