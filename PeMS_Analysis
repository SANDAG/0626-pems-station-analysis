## Analysis controls ----

min_hour_pct_observed <- 75
health_threshold <- 0.75

time_periods <- c("AM Peak", "Midday", "PM Peak")
month_order <- c("July", "October", "December", "March")
weekday_order <- c("Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday")

day_group_order <- c(
  "Monday / Friday",
  "Tuesday - Thursday",
  "Saturday / Sunday"
)

fy_order <- c("FY24", "FY25", "FY26")
report_direction_order <- c("Northbound", "Southbound")


# Section 2 - Station pair health ----
#
# First step was figuring out where we actually have enough data to report.
#
# Fixed EL / GP station pairs below. We track the same pairs across FY24-FY26.
# Weekly station health is based on completeness of valid hourly observations.
# Pair health requires BOTH the EL and GP station to pass.


## Fixed EL / GP station pairs ----

fixed_station_pairs <- tribble(
  ~direction, ~direction_label, ~el_station_id, ~el_station_name, ~gp_station_id, ~gp_station_name,
  
  "N", "Northbound", "1115829", "15 NB HOV N/O Carroll Canyon Rd",  "1115739", "15 NB N/O Carroll Cyn Rd",
  "N", "Northbound", "1121044", "15 NB HOV S/O Bernardo Center Dr", "1120994", "15 NB S/O Bernardo Center Dr",
  "N", "Northbound", "1121052", "15 NB HOV N/O Bernardo Center Dr", "1121037", "15 NB N/O Bernardo Center Dr",
  "N", "Northbound", "1121135", "15 NB HOV Green Valley Creek",      "1121099", "15 NB Green Valley Creek",
  "N", "Northbound", "1122502", "15 NB HOV N/O Auto Park Way/9th",  "1108771", "Auto Park Way/9th Ave to 15 NB",
  "N", "Northbound", "1123148", "15 NB HOV S/O Rte 78",             "1108773", "Valley Parkway to 15 NB",
  "N", "Northbound", "1125324", "15 NB HOV Valley Parkway",         "1119689", "15 NB S/O Ocean View Blvd",
  "N", "Northbound", "1125486", "15 NB HOV Felicita/Citracado Pkw", "1108769", "Felicita/Citracado Pkwy to 15 NB",
  
  "S", "Southbound", "1125503", "15 SB HOV Center City Pkwy",       "1119683", "15 SB N/O National Ave",
  "S", "Southbound", "1126631", "15 SB S/O HOV lanes",              "1115802", "15 SB S/O HOV lanes",
  "S", "Southbound", "1126837", "15 SB HOV N/O Felicita/Citracado", "1125879", "15 SB N/O Felicita/Citracado",
  "S", "Southbound", "1122925", "15 SB HOV S/O Camino del Norte",   "1123006", "15 SB S/O Camino del Norte",
  "S", "Southbound", "1121165", "15 SB HOV N/O Rancho Bernardo Rd", "1121034", "15 SB N/O Rancho Bernardo Rd",
  "S", "Southbound", "1121158", "15 SB HOV S/O Pomerado/W Bernard", "1121125", "15 SB S/O Pomerado/W Bernardo",
  "S", "Southbound", "1121142", "15 SB HOV S/O Via Rancho Parkway", "1121112", "15 SB S/O Via Rancho Parkway"
)


## Read PeMS master data ----
#
# Clean hourly master file. Cleaning upstream of this file is unchanged and
# was reviewed separately.

i15_master <- readRDS(file.path(clean_dir, "i15_master_clean.rds")) %>%
  mutate(
    station_id = as.character(station_id),
    direction = as.character(direction),
    
    facility = case_when(
      as.character(facility) %in% c("Managed Lane", "Express Lane") ~ "Express Lane",
      as.character(facility) == "GP" ~ "GP",
      TRUE ~ as.character(facility)
    ),
    
    date = as_date(ts),
    
    # Valid hourly observation
    complete_record =
      !is.na(pct_observed) &
      pct_observed >= min_hour_pct_observed &
      !is.na(samples) &
      samples > 0 &
      !is.na(avg_speed_mph) &
      avg_speed_mph > 0 &
      !is.na(total_flow_vph) &
      total_flow_vph >= 0
  )


## Build FY24-FY26 analysis weeks ----
#
# Full Monday-Sunday weeks.

analysis_weeks <- tibble(
  week_start = seq(from = ymd("2023-07-03"), to = ymd("2026-06-22"), by = "1 week")
) %>%
  mutate(
    week_end = week_start + days(6),
    
    fiscal_year = case_when(
      week_start <= ymd("2024-06-30") ~ "FY24",
      week_start <= ymd("2025-06-30") ~ "FY25",
      TRUE ~ "FY26"
    ),
    
    week_label = paste0(fiscal_year, " | ", format(week_start, "%Y-%m-%d"))
  )


## Assign hourly records to analysis weeks ----

analysis_data <- i15_master %>%
  filter(
    date >= min(analysis_weeks$week_start),
    date <= max(analysis_weeks$week_end)
  ) %>%
  mutate(week_start = floor_date(date, unit = "week", week_start = 1) %>% as_date()) %>%
  inner_join(analysis_weeks, by = "week_start")


## Expected hours per week ----
#
# Used as the denominator for weekly station completeness.

week_expected_hours <- analysis_data %>%
  group_by(fiscal_year, week_start, week_end, week_label) %>%
  summarise(expected_hours = n_distinct(ts), .groups = "drop")


## Station IDs used in pair analysis ----

station_ids <- bind_rows(
  fixed_station_pairs %>% transmute(direction, facility = "Express Lane", station_id = el_station_id),
  fixed_station_pairs %>% transmute(direction, facility = "GP", station_id = gp_station_id)
) %>%
  distinct()


## Calculate weekly station health ----

station_week_health_observed <- analysis_data %>%
  semi_join(station_ids, by = c("direction", "facility", "station_id")) %>%
  group_by(fiscal_year, week_start, week_end, week_label, direction, facility, station_id) %>%
  summarise(complete_hours = n_distinct(ts[complete_record]), .groups = "drop")


## Complete station x week grid ----
#
# Important because a station with no observations still needs to appear as
# unhealthy instead of disappearing from the table.

station_week_health <- crossing(
  station_ids,
  analysis_weeks %>% select(fiscal_year, week_start, week_end, week_label)
) %>%
  left_join(
    week_expected_hours,
    by = c("fiscal_year", "week_start", "week_end", "week_label")
  ) %>%
  left_join(
    station_week_health_observed,
    by = c(
      "fiscal_year", "week_start", "week_end", "week_label",
      "direction", "facility", "station_id"
    )
  ) %>%
  mutate(
    complete_hours = coalesce(complete_hours, 0L),
    share_complete = complete_hours / expected_hours,
    healthy = share_complete >= health_threshold
  )


## EL weekly health ----

el_week_health <- station_week_health %>%
  filter(facility == "Express Lane") %>%
  transmute(
    fiscal_year, week_start, week_end, week_label, direction,
    el_station_id = station_id,
    el_healthy = healthy
  )


## GP weekly health ----

gp_week_health <- station_week_health %>%
  filter(facility == "GP") %>%
  transmute(
    fiscal_year, week_start, week_end, week_label, direction,
    gp_station_id = station_id,
    gp_healthy = healthy
  )


## Evaluate EL / GP pair health ----
#
# Both stations need to be healthy. No substitution of alternate stations.

pair_week_health <- fixed_station_pairs %>%
  crossing(
    analysis_weeks %>% select(fiscal_year, week_start, week_end, week_label)
  ) %>%
  left_join(
    el_week_health,
    by = c(
      "fiscal_year", "week_start", "week_end", "week_label",
      "direction", "el_station_id"
    )
  ) %>%
  left_join(
    gp_week_health,
    by = c(
      "fiscal_year", "week_start", "week_end", "week_label",
      "direction", "gp_station_id"
    )
  ) %>%
  mutate(
    el_healthy = coalesce(el_healthy, FALSE),
    gp_healthy = coalesce(gp_healthy, FALSE),
    pair_healthy = el_healthy & gp_healthy
  )


## Build station-pair health matrix ----

week_levels <- analysis_weeks %>% arrange(week_start) %>% pull(week_label)

station_pair_matrix <- pair_week_health %>%
  mutate(week_label = factor(week_label, levels = week_levels)) %>%
  select(
    direction_label,
    el_station_name,
    el_station_id,
    gp_station_name,
    gp_station_id,
    week_label,
    pair_healthy
  ) %>%
  pivot_wider(
    names_from = week_label,
    values_from = pair_healthy,
    values_fill = FALSE,
    names_expand = TRUE
  ) %>%
  rename(
    Direction = direction_label,
    `EL Station` = el_station_name,
    `EL ID` = el_station_id,
    `GP Station` = gp_station_name,
    `GP ID` = gp_station_id
  ) %>%
  arrange(Direction, `EL Station`)


## Export station health matrix ----

print(station_pair_matrix, n = Inf, width = Inf)

write.csv(
  station_pair_matrix,
  file.path(output_dir, "station_pair_matrix.csv"),
  row.names = FALSE
)

cat("\nStation health matrix saved:\n", file.path(output_dir, "station_pair_matrix.csv"), "\n")


# Section 3 - Selected analysis weeks ----
#
# After reviewing station health we selected representative weeks for July,
# October, December and March.
#
# Selection favored weeks with good station availability and avoided federal
# holidays and the beginning / end of major school breaks.
#
# The reviewed selections are stored in week_selection.csv.
#
# station_selection.csv is the reviewed health matrix used from this point
# forward. Weekly health is NOT recalculated again below.


## Read reviewed health matrix ----

station_health <- read_csv(
  file.path(clean_dir, "station_selection.csv"),
  show_col_types = FALSE
) %>%
  mutate(
    `EL ID` = as.character(`EL ID`),
    `GP ID` = as.character(`GP ID`)
  )


## Read selected weeks ----

week_selection <- read_csv(
  file.path(clean_dir, "week_selection.csv"),
  show_col_types = FALSE
) %>%
  rename(
    fiscal_year = `Fiscal Year`,
    analysis_month = Month,
    week_name = Week,
    week_start = `Week Start`
  ) %>%
  mutate(
    week_start = parse_date_time(as.character(week_start), orders = c("mdy", "ymd")) %>% as_date(),
    analysis_month = factor(analysis_month, levels = month_order)
  ) %>%
  filter(!is.na(week_start)) %>%
  arrange(fiscal_year, analysis_month, week_start)


## Station pair lookup ----

station_pairs <- station_health %>%
  select(Direction, `EL Station`, `EL ID`, `GP Station`, `GP ID`) %>%
  distinct() %>%
  transmute(
    direction_label = Direction,
    
    direction = case_when(
      Direction == "Northbound" ~ "N",
      Direction == "Southbound" ~ "S",
      TRUE ~ NA_character_
    ),
    
    el_station = `EL Station`,
    el_id = as.character(`EL ID`),
    gp_station = `GP Station`,
    gp_id = as.character(`GP ID`)
  )


## Convert reviewed health matrix to long format ----

station_health_long <- station_health %>%
  pivot_longer(
    cols = matches("^FY\\d{2} \\|"),
    names_to = "week_label",
    values_to = "pair_healthy"
  ) %>%
  separate(week_label, into = c("fiscal_year", "week_start"), sep = " \\| ") %>%
  mutate(
    week_start = ymd(week_start),
    
    pair_healthy = as.character(pair_healthy) %in%
      c("TRUE", "True", "true", "YES", "Yes", "yes", "1")
  ) %>%
  transmute(
    fiscal_year,
    week_start,
    direction_label = Direction,
    el_station = `EL Station`,
    el_id = as.character(`EL ID`),
    gp_station = `GP Station`,
    gp_id = as.character(`GP ID`),
    pair_healthy
  )


## Match health matrix to selected weeks ----

selected_weeks_long <- station_health_long %>%
  inner_join(week_selection, by = c("fiscal_year", "week_start")) %>%
  mutate(analysis_month = factor(analysis_month, levels = month_order))


## QA check - selected weeks exist in health table ----

week_check <- week_selection %>%
  anti_join(
    station_health_long %>% distinct(fiscal_year, week_start),
    by = c("fiscal_year", "week_start")
  )

if (nrow(week_check) > 0) {
  print(week_check, n = Inf)
  stop("One or more selected weeks are missing from station_selection.csv.")
}


# Section 4 - Prepare selected-week PeMS data ----

## Add calendar fields and hour-level validity ----
#
# Same validity rules used above. Weekly pair health still comes from the
# reviewed health matrix.

i15_master <- i15_master %>%
  mutate(
    week_start = floor_date(date, unit = "week", week_start = 1) %>% as_date(),
    weekday_num = wday(date, week_start = 1),
    
    weekday = case_when(
      weekday_num == 1 ~ "Monday",
      weekday_num == 2 ~ "Tuesday",
      weekday_num == 3 ~ "Wednesday",
      weekday_num == 4 ~ "Thursday",
      weekday_num == 5 ~ "Friday",
      weekday_num == 6 ~ "Saturday",
      weekday_num == 7 ~ "Sunday"
    ),
    
    day_group = case_when(
      weekday_num %in% c(1, 5) ~ "Monday / Friday",
      weekday_num %in% 2:4 ~ "Tuesday - Thursday",
      weekday_num %in% 6:7 ~ "Saturday / Sunday"
    ),
    
    hour = hour(ts),
    
    time_period = case_when(
      hour %in% 6:9 ~ "AM Peak",
      hour %in% 10:14 ~ "Midday",
      hour %in% 15:18 ~ "PM Peak",
      TRUE ~ NA_character_
    ),
    
    complete =
      !is.na(pct_observed) &
      pct_observed >= min_hour_pct_observed &
      !is.na(samples) &
      samples > 0 &
      !is.na(avg_speed_mph) &
      avg_speed_mph > 0 &
      !is.na(total_flow_vph) &
      total_flow_vph >= 0
  )


## Keep selected calendar weeks ----

selected_data <- i15_master %>%
  semi_join(week_selection %>% distinct(week_start), by = "week_start")


## Selected station IDs ----

selected_station_ids <- bind_rows(
  station_pairs %>% transmute(direction, facility = "Express Lane", station_id = el_id),
  station_pairs %>% transmute(direction, facility = "GP", station_id = gp_id)
) %>%
  distinct()


# Section 5 - Selected-week variation ----
#
# Before building the final reporting table we looked at how stable the
# selected weeks actually were.
#
# Daily values let us compare individual selected weeks.
# Monthly summary statistics use the underlying hourly observations.
# They are not averages of the daily or weekly averages.


## Daily station averages ----

daily_station_performance <- selected_data %>%
  semi_join(selected_station_ids, by = c("direction", "facility", "station_id")) %>%
  filter(complete, !is.na(time_period)) %>%
  group_by(week_start, date, weekday, day_group, direction, facility, station_id, time_period) %>%
  summarise(
    speed_avg = mean(avg_speed_mph),
    vph_avg = mean(total_flow_vph),
    .groups = "drop"
  )


## Underlying hourly observations ----

hourly_station_performance <- selected_data %>%
  semi_join(selected_station_ids, by = c("direction", "facility", "station_id")) %>%
  filter(complete, !is.na(time_period)) %>%
  select(
    week_start,
    date,
    weekday,
    day_group,
    direction,
    facility,
    station_id,
    time_period,
    avg_speed_mph,
    total_flow_vph
  )


## EL daily values ----

el_daily <- daily_station_performance %>%
  filter(facility == "Express Lane") %>%
  transmute(
    week_start, date, weekday, day_group, direction, time_period,
    el_id = station_id,
    el_speed_avg = speed_avg,
    el_vph_avg = vph_avg
  )


## GP daily values ----

gp_daily <- daily_station_performance %>%
  filter(facility == "GP") %>%
  transmute(
    week_start, date, weekday, day_group, direction, time_period,
    gp_id = station_id,
    gp_speed_avg = speed_avg,
    gp_vph_avg = vph_avg
  )


## Build complete station / week / day grid ----
#
# Unhealthy station-weeks remain structurally present but their values are blank.

daily_pair_performance <- selected_weeks_long %>%
  crossing(weekday = weekday_order, time_period = time_periods) %>%
  mutate(
    weekday_num = match(weekday, weekday_order),
    date = week_start + days(weekday_num - 1),
    
    day_group = case_when(
      weekday %in% c("Monday", "Friday") ~ "Monday / Friday",
      weekday %in% c("Tuesday", "Wednesday", "Thursday") ~ "Tuesday - Thursday",
      weekday %in% c("Saturday", "Sunday") ~ "Saturday / Sunday"
    )
  ) %>%
  left_join(
    station_pairs %>% select(direction_label, direction, el_id, gp_id),
    by = c("direction_label", "el_id", "gp_id")
  ) %>%
  left_join(
    el_daily,
    by = c(
      "week_start", "date", "weekday", "day_group",
      "direction", "el_id", "time_period"
    )
  ) %>%
  left_join(
    gp_daily,
    by = c(
      "week_start", "date", "weekday", "day_group",
      "direction", "gp_id", "time_period"
    )
  ) %>%
  mutate(
    across(
      c(el_speed_avg, gp_speed_avg, el_vph_avg, gp_vph_avg),
      ~ if_else(pair_healthy, .x, NA_real_)
    ),
    
    column_label = paste0(as.character(analysis_month), " ", week_name, " | ", weekday)
  )


## Daily speed values ----

speed_long <- daily_pair_performance %>%
  select(
    fiscal_year, analysis_month, week_name, week_start, column_label,
    direction_label, direction, el_station, el_id, gp_station, gp_id,
    day_group, weekday, time_period, pair_healthy, el_speed_avg, gp_speed_avg
  ) %>%
  pivot_longer(
    cols = c(el_speed_avg, gp_speed_avg),
    names_to = "source_metric",
    values_to = "numeric_value"
  ) %>%
  mutate(
    metric = recode(
      source_metric,
      el_speed_avg = "el_speed_mph",
      gp_speed_avg = "gp_speed_mph"
    ),
    
    station_id = case_when(
      metric == "el_speed_mph" ~ el_id,
      metric == "gp_speed_mph" ~ gp_id
    ),
    
    output_value = case_when(
      is.na(numeric_value) ~ "",
      TRUE ~ format(round(numeric_value, 1), nsmall = 1, trim = TRUE)
    )
  ) %>%
  select(-source_metric)


## Daily VPH values ----

vph_long <- daily_pair_performance %>%
  select(
    fiscal_year, analysis_month, week_name, week_start, column_label,
    direction_label, direction, el_station, el_id, gp_station, gp_id,
    day_group, weekday, time_period, pair_healthy, el_vph_avg, gp_vph_avg
  ) %>%
  pivot_longer(
    cols = c(el_vph_avg, gp_vph_avg),
    names_to = "source_metric",
    values_to = "numeric_value"
  ) %>%
  mutate(
    metric = recode(
      source_metric,
      el_vph_avg = "el_vph",
      gp_vph_avg = "gp_vph"
    ),
    
    station_id = case_when(
      metric == "el_vph" ~ el_id,
      metric == "gp_vph" ~ gp_id
    ),
    
    output_value = case_when(
      is.na(numeric_value) ~ "",
      TRUE ~ format(round(numeric_value, 0), scientific = FALSE, trim = TRUE)
    )
  ) %>%
  select(-source_metric)


## Healthy selected station-weeks ----
#
# Only TRUE pair/weeks enter the pooled monthly statistics.

included_station_weeks <- selected_weeks_long %>%
  filter(pair_healthy) %>%
  select(
    fiscal_year,
    analysis_month,
    week_start,
    direction_label,
    el_id,
    gp_id
  ) %>%
  left_join(
    station_pairs %>% select(direction_label, direction, el_id, gp_id),
    by = c("direction_label", "el_id", "gp_id")
  )


## EL pooled monthly statistics ----
#
# Average, 25th, 75th, IQR, Min, Max and Count all use the same hourly pool.

el_monthly_summary <- hourly_station_performance %>%
  filter(facility == "Express Lane") %>%
  inner_join(
    included_station_weeks,
    by = c("week_start", "direction", "station_id" = "el_id")
  ) %>%
  group_by(
    fiscal_year,
    analysis_month,
    direction_label,
    station_id,
    day_group,
    time_period
  ) %>%
  summarise(
    speed_avg = mean(avg_speed_mph),
    speed_p25 = quantile(avg_speed_mph, probs = 0.25, type = 7, names = FALSE),
    speed_p75 = quantile(avg_speed_mph, probs = 0.75, type = 7, names = FALSE),
    speed_iqr = speed_p75 - speed_p25,
    speed_min = min(avg_speed_mph),
    speed_max = max(avg_speed_mph),
    speed_count = n(),
    
    vph_avg = mean(total_flow_vph),
    vph_p25 = quantile(total_flow_vph, probs = 0.25, type = 7, names = FALSE),
    vph_p75 = quantile(total_flow_vph, probs = 0.75, type = 7, names = FALSE),
    vph_iqr = vph_p75 - vph_p25,
    vph_min = min(total_flow_vph),
    vph_max = max(total_flow_vph),
    vph_count = n(),
    
    .groups = "drop"
  )


## GP pooled monthly statistics ----

gp_monthly_summary <- hourly_station_performance %>%
  filter(facility == "GP") %>%
  inner_join(
    included_station_weeks,
    by = c("week_start", "direction", "station_id" = "gp_id")
  ) %>%
  group_by(
    fiscal_year,
    analysis_month,
    direction_label,
    station_id,
    day_group,
    time_period
  ) %>%
  summarise(
    speed_avg = mean(avg_speed_mph),
    speed_p25 = quantile(avg_speed_mph, probs = 0.25, type = 7, names = FALSE),
    speed_p75 = quantile(avg_speed_mph, probs = 0.75, type = 7, names = FALSE),
    speed_iqr = speed_p75 - speed_p25,
    speed_min = min(avg_speed_mph),
    speed_max = max(avg_speed_mph),
    speed_count = n(),
    
    vph_avg = mean(total_flow_vph),
    vph_p25 = quantile(total_flow_vph, probs = 0.25, type = 7, names = FALSE),
    vph_p75 = quantile(total_flow_vph, probs = 0.75, type = 7, names = FALSE),
    vph_iqr = vph_p75 - vph_p25,
    vph_min = min(total_flow_vph),
    vph_max = max(total_flow_vph),
    vph_count = n(),
    
    .groups = "drop"
  )


## Speed monthly summary ----

speed_summary <- bind_rows(
  el_monthly_summary %>%
    transmute(
      fiscal_year, analysis_month, direction_label, station_id, day_group, time_period,
      metric = "el_speed_mph",
      monthly_avg = round(speed_avg, 1),
      monthly_p25 = round(speed_p25, 1),
      monthly_p75 = round(speed_p75, 1),
      monthly_iqr = round(speed_iqr, 1),
      monthly_min = round(speed_min, 1),
      monthly_max = round(speed_max, 1),
      monthly_count = speed_count
    ),
  
  gp_monthly_summary %>%
    transmute(
      fiscal_year, analysis_month, direction_label, station_id, day_group, time_period,
      metric = "gp_speed_mph",
      monthly_avg = round(speed_avg, 1),
      monthly_p25 = round(speed_p25, 1),
      monthly_p75 = round(speed_p75, 1),
      monthly_iqr = round(speed_iqr, 1),
      monthly_min = round(speed_min, 1),
      monthly_max = round(speed_max, 1),
      monthly_count = speed_count
    )
)


## VPH monthly summary ----

vph_summary <- bind_rows(
  el_monthly_summary %>%
    transmute(
      fiscal_year, analysis_month, direction_label, station_id, day_group, time_period,
      metric = "el_vph",
      monthly_avg = round(vph_avg, 0),
      monthly_p25 = round(vph_p25, 0),
