## IQR percentile table helper ----

make_iqr_percentile_table <- function(percentile) {
  
  iqr_distribution %>%
    group_by(day_group, analysis_month, metric_type) %>%
    summarise(
      value = quantile(
        monthly_iqr,
        probs = percentile,
