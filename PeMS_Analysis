# Lowest-speed paired location comparison ----

## For each direction and time period, identify the paired ML/GP location
## where either facility has the lowest speed.
## Then compare ML and GP performance at that paired location.

lowest_speed_pair_compare <- closest_station_pair_tod_compare %>%
  mutate(
    direction_short = case_when(
      direction == "N" ~ "NB",
      direction == "S" ~ "SB",
      TRUE ~ direction
    ),
    comparison_post_mile = round((ml_post_mile + gp_post_mile) / 2, 3),
    lowest_pair_speed_mph = pmin(ml_speed_mph, gp_speed_mph, na.rm = TRUE),
    slowest_facility = case_when(
      ml_speed_mph < gp_speed_mph ~ "ML",
      gp_speed_mph < ml_speed_mph ~ "GP",
      TRUE ~ "Tie"
    ),
    comparison_location = case_when(
      slowest_facility == "ML" ~ ml_station_name,
      slowest_facility == "GP" ~ gp_station_name,
      TRUE ~ ml_station_name
    )
  ) %>%
  group_by(direction, direction_label, tod) %>%
  slice_min(lowest_pair_speed_mph, n = 1, with_ties = FALSE) %>%
  ungroup() %>%
  arrange(direction, tod)


# Top 10 slowest paired ML/GP locations ----

## One row per paired physical location.
## The table is ranked by the lowest speed observed in either GP or ML.
## If the same location appears more than once, keep the slowest case only.

paired_location_candidates <- closest_station_pair_tod_compare %>%
  filter(
    !is.na(gp_speed_mph),
    !is.na(ml_speed_mph)
  ) %>%
  mutate(
    direction_short = case_when(
      direction == "N" ~ "NB",
      direction == "S" ~ "SB",
      TRUE ~ direction
    ),
    comparison_post_mile = round((ml_post_mile + gp_post_mile) / 2, 3),
    comparison_post_mile_key = sprintf("%.3f", comparison_post_mile),
    lowest_pair_speed_mph = pmin(gp_speed_mph, ml_speed_mph),
    slowest_facility = case_when(
      ml_speed_mph < gp_speed_mph ~ "ML",
      gp_speed_mph < ml_speed_mph ~ "GP",
      TRUE ~ "Tie"
    ),
    location_name = case_when(
      slowest_facility == "ML" ~ ml_station_name,
      slowest_facility == "GP" ~ gp_station_name,
      TRUE ~ ml_station_name
    )
  )


top10_slowest_paired_locations <- paired_location_candidates %>%
  arrange(
    lowest_pair_speed_mph,
    desc(abs(managed_minus_gp_speed_mph))
  ) %>%
  distinct(
    direction_short,
    comparison_post_mile_key,
    .keep_all = TRUE
  ) %>%
  slice_head(n = 10) %>%
  transmute(
    Direction = direction_short,
    Period = as.character(tod),
    Location = location_name,
    `Post Mile` = comparison_post_mile,
    `Slowest Facility` = slowest_facility,
    `GP Speed (mph)` = round(gp_speed_mph, 1),
    `ML Speed (mph)` = round(ml_speed_mph, 1),
