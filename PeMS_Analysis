# Caltrans State Highway Network Lines ----

## Caltrans SHN Lines FeatureServer.
## Query I-15 in District 11 and request GeoJSON in WGS84.

shn_query_url <- paste0(
  "https://caltrans-gis.dot.ca.gov/arcgis/rest/services/CHhighway/SHN_Lines/FeatureServer/0/query?",
  "where=", URLencode("Route = 15 AND District = 11", reserved = TRUE),
  "&outFields=Route,RouteS,County,District,bPM,ePM,Direction,AlignCode",
  "&returnGeometry=true",
  "&outSR=4326",
  "&f=geojson"
)

i15_shn <- st_read(shn_query_url, quiet = TRUE) %>%
  st_make_valid()


