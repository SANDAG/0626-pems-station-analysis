# Station-pair speed and ADT CSV ----

## Creates one row per ML/GP station pair by time of day.
## Location is always the ML station name.
## ADT is average daily volume during that time-of-day period.
## Volumes are not lane-normalized.

if (!exists("i15_selected")) {
  stop("Object `i15_selected` does not exist. Run the selected station analysis first.")
}

if (!exists("closest_gp_to_ml")) {
  stop("Object `closest_gp_to_ml` does not exist. Run the station-pair selection first.")
}

analysis_output_dir <- file.path("4_Outputs")
dir.create(analysis_output_dir, showWarnings = FALSE, recursive = TRUE)


# Build clean station-pair lookup ----

## Each ML station gets one nearest GP station.
## The location field is the ML station name.

station_pair_lookup <- closest_gp_to_ml %>%
  transmute(
    direction,
    direction_label,
    ml_station_id,
    gp_station_id,
    location = ml_station_name,
    post_mile = ml_post_mile,
    ml_station_name,
    gp_station_name,
    ml_post_mile,
    gp_post_mile,
    station_distance_mi
  ) %>%
  distinct(
    direction,
    ml_station_id,
    gp_station_id,
    .keep_all = TRUE
  ) %>%
  arrange(direction, post_mile)


print_table("Station pair lookup:", station_pair_lookup, n = 100)


# Station-day-period performance ----

## First calculate daily period volume and speed for each station.

station_day_tod <- i15_selected %>%
  group_by(
    date,
    direction,
    direction_label,
    facility,
    station_id,
    tod
  ) %>%
  summarise(
    daily_period_volume = sum(total_flow_vph, na.rm = TRUE),
    daily_period_speed = weighted_speed(avg_speed_mph, total_flow_vph),
    .groups = "drop"
  )


# Station-level time-of-day summary ----

## Average across days for each station and time period.

station_tod_summary <- station_day_tod %>%
  group_by(
    direction,
    direction_label,
    facility,
    station_id,
    tod
  ) %>%
  summarise(
    speed_mph = weighted_speed(daily_period_speed, daily_period_volume),
    adt = mean(daily_period_volume, na.rm = TRUE),
    days_observed = n_distinct(date),
    .groups = "drop"
  )


# Split GP and ML station summaries ----

ml_tod_summary <- station_tod_summary %>%
  filter(facility == "Managed Lane") %>%
  transmute(
    direction,
    tod,
    ml_station_id = station_id,
    ml_speed_mph = speed_mph,
    ml_adt = adt,
    ml_days_observed = days_observed
  )


gp_tod_summary <- station_tod_summary %>%
  filter(facility == "GP") %>%
  transmute(
    direction,
    tod,
    gp_station_id = station_id,
    gp_speed_mph = speed_mph,
    gp_adt = adt,
    gp_days_observed = days_observed
  )


# Join GP and ML performance to each station pair ----

station_pair_tod_speed_adt <- station_pair_lookup %>%
  left_join(
    ml_tod_summary,
    by = c("direction", "ml_station_id")
  ) %>%
  left_join(
    gp_tod_summary,
    by = c("direction", "gp_station_id", "tod")
  ) %>%
  mutate(
    direction_short = case_when(
      direction == "N" ~ "NB",
      direction == "S" ~ "SB",
      TRUE ~ direction
    ),
    time_of_day = as.character(tod),
    ml_minus_gp_speed_mph = ml_speed_mph - gp_speed_mph,
    ml_to_gp_adt_ratio = ml_adt / gp_adt
  ) %>%
  distinct(
    direction_short,
    ml_station_id,
    gp_station_id,
    time_of_day,
    .keep_all = TRUE
  ) %>%
  transmute(
    direction = direction_short,
    location,
    post_mile = round(post_mile, 3),
    time_of_day,
    
    gp_speed_mph = round(gp_speed_mph, 1),
    ml_speed_mph = round(ml_speed_mph, 1),
    ml_minus_gp_speed_mph = round(ml_minus_gp_speed_mph, 1),
    
    gp_adt = round(gp_adt, 0),
    ml_adt = round(ml_adt, 0),
    ml_to_gp_adt_ratio = round(ml_to_gp_adt_ratio, 2),
    
    gp_station_id,
    ml_station_id,
    station_distance_mi = round(station_distance_mi, 3),
    gp_days_observed,
    ml_days_observed
  ) %>%
  mutate(
    time_of_day = factor(
      time_of_day,
      levels = c("AM Peak", "PM Peak", "Off-Peak")
    )
  ) %>%
  arrange(
    direction,
    post_mile,
    time_of_day
  )


