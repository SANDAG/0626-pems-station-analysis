#
# A flagged speed cell has to be text because three values are displayed in
# the same Excel cell. Other reported values stay numeric.

write_speed_cell <- function(wb, sheet, row, col, avg_speed, p25, p75, iqr) {
  
  if (is.na(avg_speed)) return(invisible(NULL))
  
  if (!is.na(iqr) && iqr >= speed_iqr_threshold) {
    
    value <- paste0(
      sprintf("%.1f", avg_speed),
      "\n(",
      sprintf("%.1f", p25),
      ", ",
      sprintf("%.1f", p75),
      ")"
    )
    
    writeData(
      wb, sheet, value,
      startRow = row,
      startCol = col,
      colNames = FALSE
    )
    
  } else {
    
    writeData(
      wb, sheet, round(avg_speed, 1),
      startRow = row,
      startCol = col,
      colNames = FALSE
    )
  }
}


