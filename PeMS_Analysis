        gridExpand = TRUE
      )
      
      current_row <- current_row + 1
      
      
      ### Metric headers ----
      
      writeData(
        report_wb, this_month, t(column_headers),
        startRow = current_row,
        startCol = 1,
        colNames = FALSE
      )
      
      addStyle(
        report_wb, this_month,
        style = wrap_style,
        rows = current_row,
        cols = 1:16,
        gridExpand = TRUE
      )
      
      addStyle(
        report_wb, this_month,
        style = bold_style,
        rows = current_row,
        cols = 1:16,
        gridExpand = TRUE,
        stack = TRUE
      )
      
      current_row <- current_row + 1
      
      
      ### Direction blocks ----
      
      for (this_direction in report_direction_order) {
        
        writeData(
          report_wb, this_month, this_direction,
          startRow = current_row,
          startCol = 1,
          colNames = FALSE
        )
        
        addStyle(
          report_wb, this_month,
          style = bold_style,
          rows = current_row,
          cols = 1
        )
        
        current_row <- current_row + 1
        
        this_table <- get_report_block(
          this_fy,
          this_month,
          this_day_group,
          this_direction
        )
        
        
        ### Station rows ----
        
        if (nrow(this_table) > 0) {
          
          for (j in seq_len(nrow(this_table))) {
            
            excel_row <- current_row + j - 1
            
            
            # Station / Post Mile
            
            writeData(
              report_wb, this_month, this_table$el_station[j],
              startRow = excel_row, startCol = 1, colNames = FALSE
            )
            
            if (!is.na(this_table$post_mile[j])) {
              writeData(
                report_wb, this_month, as.numeric(this_table$post_mile[j]),
                startRow = excel_row, startCol = 2, colNames = FALSE
              )
            }
            
            
            # AM
            
            write_speed_cell(
              report_wb, this_month, excel_row, 3,
              this_table$am_gp_speed[j],
              this_table$am_gp_p25[j],
              this_table$am_gp_p75[j],
              this_table$am_gp_iqr[j]
            )
            
            write_speed_cell(
              report_wb, this_month, excel_row, 4,
              this_table$am_el_speed[j],
              this_table$am_el_p25[j],
              this_table$am_el_p75[j],
              this_table$am_el_iqr[j]
            )
            
            if (!is.na(this_table$am_gp_vph[j])) {
              writeData(
                report_wb, this_month, round(this_table$am_gp_vph[j]),
                startRow = excel_row, startCol = 5, colNames = FALSE
              )
            }
            
            if (!is.na(this_table$am_el_vph[j])) {
              writeData(
                report_wb, this_month, round(this_table$am_el_vph[j]),
                startRow = excel_row, startCol = 6, colNames = FALSE
              )
            }
            
            
            # Midday
            
            write_speed_cell(
              report_wb, this_month, excel_row, 7,
              this_table$midday_gp_speed[j],
              this_table$midday_gp_p25[j],
              this_table$midday_gp_p75[j],
              this_table$midday_gp_iqr[j]
            )
            
            write_speed_cell(
              report_wb, this_month, excel_row, 8,
              this_table$midday_el_speed[j],
              this_table$midday_el_p25[j],
              this_table$midday_el_p75[j],
              this_table$midday_el_iqr[j]
            )
            
            if (!is.na(this_table$midday_gp_vph[j])) {
              writeData(
                report_wb, this_month, round(this_table$midday_gp_vph[j]),
                startRow = excel_row, startCol = 9, colNames = FALSE
              )
            }
            
            if (!is.na(this_table$midday_el_vph[j])) {
              writeData(
                report_wb, this_month, round(this_table$midday_el_vph[j]),
                startRow = excel_row, startCol = 10, colNames = FALSE
              )
            }
            
            
            # PM
            
            write_speed_cell(
              report_wb, this_month, excel_row, 11,
              this_table$pm_gp_speed[j],
              this_table$pm_gp_p25[j],
              this_table$pm_gp_p75[j],
              this_table$pm_gp_iqr[j]
            )
            
            write_speed_cell(
              report_wb, this_month, excel_row, 12,
              this_table$pm_el_speed[j],
              this_table$pm_el_p25[j],
              this_table$pm_el_p75[j],
              this_table$pm_el_iqr[j]
            )
            
            if (!is.na(this_table$pm_gp_vph[j])) {
              writeData(
                report_wb, this_month, round(this_table$pm_gp_vph[j]),
                startRow = excel_row, startCol = 13, colNames = FALSE
              )
            }
            
            if (!is.na(this_table$pm_el_vph[j])) {
              writeData(
                report_wb, this_month, round(this_table$pm_el_vph[j]),
                startRow = excel_row, startCol = 14, colNames = FALSE
              )
            }
            
            
            # ADT
            
            if (!is.na(this_table$gp_adt[j])) {
              writeData(
                report_wb, this_month, round(this_table$gp_adt[j]),
                startRow = excel_row, startCol = 15, colNames = FALSE
              )
            }
            
            if (!is.na(this_table$el_adt[j])) {
              writeData(
                report_wb, this_month, round(this_table$el_adt[j]),
                startRow = excel_row, startCol = 16, colNames = FALSE
              )
            }
          }
          
          
          # Allows flagged speed cells to display on two lines
          
          addStyle(
            report_wb, this_month,
            style = wrap_style,
            rows = current_row:(current_row + nrow(this_table) - 1),
            cols = 1:16,
            gridExpand = TRUE
          )
          
          current_row <- current_row + nrow(this_table)
        }
      }
      
      current_row <- current_row + 2
    }
    
    current_row <- current_row + 2
  }
}


# Section 12 - Save final report ----

saveWorkbook(
  report_wb,
  report_output_file,
  overwrite = TRUE
)

cat("\nReporting workbook saved:\n", report_output_file, "\n")
