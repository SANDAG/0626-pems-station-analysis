      .groups = "drop"
    ) %>%
    mutate(
      value = case_when(
        metric_type == "Speed" ~ round(value, 1),
        metric_type == "VPH" ~ round(value, 0)
      )
    ) %>%
    pivot_wider(names_from = analysis_month, values_from = value) %>%
    arrange(metric_type, day_group)
}


