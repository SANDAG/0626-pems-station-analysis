analysis_hours <- i15_analysis_base %>%
  distinct(ts, month) %>%
  arrange(ts)

analysis_hour_vec <- sort(unique(analysis_hours$ts))


count_expected_hours_from_data <- function(start_ts, end_ts, hour_vec) {
  
  if (is.na(start_ts) || is.na(end_ts) || end_ts < start_ts) {
    return(NA_integer_)
  }
  
  sum(hour_vec >= start_ts & hour_vec <= end_ts)
}


station_health_detail <- i15_analysis_base %>%
  group_by(direction, direction_label, facility, station_id) %>%
  summarise(
    first_ts = min(ts, na.rm = TRUE),
    last_ts = max(ts, na.rm = TRUE),
    
    records_present = n_distinct(ts),
    reported_records = n_distinct(ts[reported_record]),
    complete_records = n_distinct(ts[complete_record]),
    
    avg_pct_observed = safe_mean(pct_observed),
    median_pct_observed = safe_median(pct_observed),
    min_pct_observed = safe_min(pct_observed),
    
    station_length_mi = safe_median(station_length_mi),
    corridor_mile = safe_median(corridor_mile),
    latitude = safe_median(latitude),
    longitude = safe_median(longitude),
    station_name = safe_first_character(station_name),
    
    .groups = "drop"
  ) %>%
  rowwise() %>%
  mutate(
    expected_records = count_expected_hours_from_data(
      start_ts = first_ts,
      end_ts = last_ts,
      hour_vec = analysis_hour_vec
    )
  ) %>%
  ungroup() %>%
  mutate(
    share_records_present = records_present / expected_records,
    share_reported = reported_records / expected_records,
    share_complete = complete_records / expected_records,
    healthy_station = share_complete >= health_threshold
  ) %>%
  arrange(direction, facility, corridor_mile, station_id)


station_health_summary <- station_health_detail %>%
  group_by(direction, direction_label, facility) %>%
  summarise(
    stations_total = n_distinct(station_id),
    
    healthy_stations = sum(
      healthy_station,
      na.rm = TRUE
    ),
    
    unhealthy_stations =
      stations_total - healthy_stations,
    
    share_healthy =
      healthy_stations / stations_total,
    
    avg_share_complete = mean(
      share_complete,
      na.rm = TRUE
    ),
    
    stations_share_complete_75 = sum(
      share_complete >= health_threshold,
      na.rm = TRUE
    ),
    
    stations_pct_observed_75 = sum(
      avg_pct_observed >= min_hour_pct_observed,
      na.rm = TRUE
    ),
    
    group_avg_pct_observed = mean(
      avg_pct_observed,
      na.rm = TRUE
    ),
    
    .groups = "drop"
  ) %>%
  arrange(direction, facility)

