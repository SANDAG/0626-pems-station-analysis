## Read and combine station-hour files.
## Then filter to I-15 northbound and southbound GP / managed lane records.

i15_master_clean <- map_dfr(station_hour_paths, read_station_hour_simple) %>%
  filter(
    freeway == 15,
    direction %in% c("N", "S"),
    lane_type %in% c("ML", "HV")
  ) %>%
  left_join(station_meta, by = "station_id") %>%
  mutate(
    facility = case_when(
      lane_type == "ML" ~ "GP",
      lane_type == "HV" ~ "Managed Lane",
      TRUE ~ NA_character_
    ),
    facility = factor(facility, levels = c("GP", "Managed Lane")),
    
    direction_label = case_when(
      direction == "N" ~ "Northbound",
      direction == "S" ~ "Southbound",
      TRUE ~ direction
    ),
    
    date = as_date(ts),
    month = floor_date(date, "month"),
    hour = hour(ts),
    weekday_num = wday(date, week_start = 1),
    is_weekday = weekday_num <= 5,
    
    tod = case_when(
      hour %in% 6:9 ~ "AM Peak",
      hour %in% 15:18 ~ "PM Peak",
      TRUE ~ "Off-Peak"
    ),
    tod = factor(tod, levels = c("AM Peak", "PM Peak", "Off-Peak")),
    
    valid_speed = !is.na(avg_speed_mph) & avg_speed_mph > 0,
    valid_volume = !is.na(total_flow_vph) & total_flow_vph >= 0,
    
    reported_record =
      !is.na(pct_observed) &
      pct_observed >= min_hour_pct_observed &
      !is.na(samples) &
      samples > 0,
    
    complete_record =
      reported_record &
      valid_speed &
      valid_volume,
    
    corridor_mile = coalesce(.data$abs_pm, .data$state_pm_num),
    
    station_travel_time_min = case_when(
      complete_record &
        !is.na(station_length_mi) &
        station_length_mi > 0 &
        avg_speed_mph > 0 ~ station_length_mi / avg_speed_mph * 60,
      TRUE ~ NA_real_
    )
  ) %>%
  arrange(ts, direction, facility, corridor_mile, station_id)


