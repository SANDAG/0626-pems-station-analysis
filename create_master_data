## Observation-rate distribution.

cat("\npct_observed distribution:\n")
i15_master_clean %>%
  mutate(
    pct_observed_bucket = case_when(
      is.na(pct_observed) ~ "Missing",
      pct_observed == 0 ~ "0",
      pct_observed > 0 & pct_observed < 50 ~ "1-49",
      pct_observed >= 50 & pct_observed < 75 ~ "50-74",
      pct_observed >= 75 & pct_observed < 90 ~ "75-89",
      pct_observed >= 90 & pct_observed < 100 ~ "90-99",
      pct_observed == 100 ~ "100",
      TRUE ~ "Other"
    )
  ) %>%
  count(direction, direction_label, facility, pct_observed_bucket) %>%
  group_by(direction, direction_label, facility) %>%
  mutate(share = n / sum(n)) %>%
  ungroup() %>%
  arrange(direction, facility, pct_observed_bucket) %>%
  base::print(row.names = FALSE)


