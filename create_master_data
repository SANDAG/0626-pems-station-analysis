# Helper functions ----

## Flexible column picker.
## This allows the metadata reader to tolerate small differences in column names.

pick_col <- function(data, candidates) {
  
  hit <- intersect(candidates, names(data))
  
  if (length(hit) == 0) {
    return(rep(NA_character_, nrow(data)))
  }
  
  data[[hit[1]]]
}


## Empty metadata structure.
## This prevents downstream errors if the metadata file exists but does not produce matches.

empty_station_meta <- function() {
  
  tibble(
    station_id = integer(),
    meta_freeway = integer(),
    meta_direction = character(),
    county = character(),
    city = character(),
    state_pm = character(),
    state_pm_num = numeric(),
    abs_pm = numeric(),
    latitude = numeric(),
    longitude = numeric(),
    station_name = character()
  )
}


# Read station-hour data ----

## Read one station-hour file.
## Only the first 12 fields are retained because those are the station-level fields needed here.

read_station_hour_simple <- function(path) {
  
  message("Reading ", basename(path), " ...")
  
  con <- gzfile(path, open = "rt")
  
  raw <- tryCatch(
    read.csv(
      file = con,
      header = FALSE,
      stringsAsFactors = FALSE,
      na.strings = c("", "NA", "-1", "-99")
    ),
    finally = close(con)
  ) %>%
    clean_names()
  
  raw %>%
    transmute(
      ts = mdy_hms(v1, tz = "America/Los_Angeles"),
      station_id = as.integer(v2),
      district = as.integer(v3),
      freeway = as.integer(v4),
      direction = as.character(v5),
      lane_type = as.character(v6),
      station_length_mi = as.numeric(v7),
      samples = as.numeric(v8),
      pct_observed = as.numeric(v9),
      total_flow_vph = as.numeric(v10),
      avg_occupancy = as.numeric(v11),
      avg_speed_mph = as.numeric(v12)
    )
}


# Read station metadata ----

## The District 11 PeMS metadata file is tab-delimited.
## The metadata fields are used to add postmile, latitude, longitude, and station name.

read_station_meta <- function(path) {
  
  if (length(path) == 0 || is.na(path) || !file.exists(path)) {
    warning("No station metadata file found.")
    return(empty_station_meta())
  }
  
  message("Reading metadata file: ", basename(path))
  
  meta_raw <- suppressMessages(
    read_tsv(
      path,
      na = c("", "NA", "-1", "-99"),
      show_col_types = FALSE,
      col_types = cols(.default = col_character()),
      trim_ws = TRUE
    )
  ) %>%
    clean_names()
  
  cat("\nMetadata columns:\n")
  print(names(meta_raw))
  
  meta_raw %>%
    transmute(
      station_id = as.integer(pick_col(meta_raw, c("id", "station", "station_id"))),
      meta_freeway = as.integer(pick_col(meta_raw, c("fwy", "freeway"))),
      meta_direction = as.character(pick_col(meta_raw, c("dir", "direction"))),
      county = as.character(pick_col(meta_raw, c("county"))),
      city = as.character(pick_col(meta_raw, c("city"))),
      state_pm = as.character(pick_col(meta_raw, c("state_pm", "state_postmile", "postmile"))),
      state_pm_num = parse_number(state_pm),
      abs_pm = as.numeric(pick_col(meta_raw, c("abs_pm", "absolute_pm", "absolute_postmile"))),
      latitude = as.numeric(pick_col(meta_raw, c("latitude", "lat"))),
      longitude = as.numeric(pick_col(meta_raw, c("longitude", "lon", "lng"))),
      station_name = as.character(pick_col(meta_raw, c("name", "station_name")))
    ) %>%
    filter(!is.na(station_id)) %>%
    distinct(station_id, .keep_all = TRUE)
}


